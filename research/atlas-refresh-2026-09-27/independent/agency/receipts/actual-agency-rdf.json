      "event": {
        "dateBasis": "FARRA sec. 1301's effective date, the earlier of 1999-10-01 or the sec. 1601 plan's abolition date",
        "effectiveDate": "1999-10-01",
        "eventId": "event:fr510",
        "originals": [
          {
            "publisherName": "United States Information Agency",
            "resourceIri": "urn:ref:federal-register-agency:510"
          }
        ],
        "results": [
          {
            "publisherName": "Broadcasting Board of Governors",
            "reasoning": "The Board is not new: the 1994 International Broadcasting Act consolidated broadcasting into USIA under it, and FARRA carved it out of the abolition and continued it, so USIA's broadcasting functions stayed there, not at State. The International Broadcasting Bureau (FR 256, sealed name International Broadcasting Board) is its component and stays with it.",
            "resourceIri": "urn:ref:federal-register-agency:41",
            "rowId": "succ:fr510:fr41",
            "functionsTaken": "international broadcasting, which the Board already held inside USIA and kept: sec. 1311 excepts the Board and the International Broadcasting Bureau from the abolition, sec. 1312(b) keeps them and their functions out of the transfer to State, and sec. 1322 continues the Board as an independent establishment"
          },
          {
            "publisherName": "State Department",
            "reasoning": "The 1998 restructuring Act abolished USIA and vested every remaining function in the Secretary of State, effective 1999-10-01 under sec. 1301's default; if the owner holds that the plan abolished USIA earlier, the owner fixes that date.",
            "resourceIri": "urn:ref:federal-register-agency:476",
            "rowId": "succ:fr510:fr476",
            "functionsTaken": "every USIA function other than broadcasting: all functions of the Director and of the agency, transferred to the Secretary of State (FARRA sec. 1312(a))"
          }
        ]
      }
    },
